{
  "name": "purrtypos",
  "version": "0.5.2",
  "description": "写作",
  "author": "Lybrand",
  "main": "electron/main_python.js",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "concurrently -k \"node scripts/run-web-backend.cjs\" \"vite --open\"",
    "prepare:backend-resources": "node scripts/prepare-backend-resources.cjs",
    "build:backend:win": "py -m pip install -q -r backend/requirements.txt pyinstaller && py -m PyInstaller --clean --noconfirm --distpath backend/dist --workpath backend/build backend/purrtypos-backend.spec",
    "build:win": "npm run build:backend:win && npm run build:electron",
    "build": "npm run build:electron",
    "build:electron": "node scripts/prepare-backend-resources.cjs && node build/icon.js && vite build && node -e \"try { require('fs').rmSync('dist-electron', { recursive: true, force: true }) } catch (e) {}\" && electron-builder",
    "build:web": "vite build && node scripts/prepare-backend-resources.cjs && node scripts/package-local-web.cjs",
    "build:web:win": "npm run build:backend:win && npm run build:web",
    "build:no-clean": "node scripts/prepare-backend-resources.cjs && node build/icon.js && vite build && electron-builder",
    "test:electron": "node --test electron/*.test.js",
    "test:unit": "node --test build/icon.test.js electron/*.test.js src/modelCatalog.test.cjs src/ScreenplayAgentPage/sourceScope.test.ts src/Workspace/AiPanel/hooks/modelRuntime.test.cjs src/Workspace/DirectorNotebook/ChapterSectionModel.test.cjs src/Workspace/DashboardPanel/dashboardFormatters.test.cjs",
    "test:backend": "node scripts/run-backend-tests.cjs",
    "test:screenplay-acceptance": "node scripts/run-backend-tests.cjs backend/tests/test_screenplay_acceptance_scenarios.py",
    "typecheck": "tsc --noEmit",
    "check:purr-ui": "node scripts/check-purr-ui.cjs",
    "check": "npm run check:purr-ui && npm run typecheck && npm run test:unit && npm run test:backend",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@base-ui/react": "^1.6.0",
    "@lexical/react": "^0.41.0",
    "@tiptap/extension-heading": "^3.20.0",
    "@tiptap/extension-table": "^3.20.1",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "adm-zip": "^0.5.16",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lexical": "^0.41.0",
    "marked": "^17.0.4",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.3",
    "remark-gfm": "^4.0.1",
    "simple-mind-map": "^0.14.0-fix.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^2.1.8",
    "pngjs": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.77.6",
    "typescript": "^5.2.2",
    "vite": "^8.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.purrtypos.app",
    "productName": "PurrTypos",
    "electronDist": "node_modules/electron/dist",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "electron/main_python.js",
      "electron/preload_python.js",
      "dist",
      "dist/**/*",
      "electron",
      "electron/**/*",
      "!electron/**/*.test.js",
      "public/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build-resources/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  }
}
