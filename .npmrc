# .npmrc
registry=https://registry.npmmirror.com/
electron_mirror=https://npmmirror.com/mirrors/electron/
# electron-builder 的 DMG 工具在 npmmirror 上不完整，使用上游默认源。
node_gyp_mirror=https://npmmirror.com/mirrors/node-gyp/
sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/sqlite3/

# 避免 IPv6 超时导致卡住
prefer-ipv4=true
# 拉取超时时间（毫秒），网络慢时可适当加大
fetch-timeout=120000

# mem0ai 等包的 peer 版本与当前安装不一致，用 legacy-peer-deps 避免 npm i 报错
legacy-peer-deps=true
